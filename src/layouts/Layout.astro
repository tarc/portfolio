---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Portfolio',
	description = 'Personal portfolio site',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
		<script is:inline>
			const theme = localStorage.getItem('theme');
			if (theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
		<header class="sticky top-0 z-10 backdrop-blur border-b border-gray-200 bg-white/80 dark:border-gray-800 dark:bg-gray-900/80">
			<!-- Phones: name and icons on the first row, the links on a second,
			     full-width row. From md up: one row, as name, links, icons. -->
			<nav class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-y-2 px-4 py-3">
				<a href="/" class="font-semibold">TARCISIO</a>
				<div data-check="nav-links" class="order-last flex w-full flex-wrap items-center justify-between gap-x-3 text-sm uppercase md:order-none md:ml-auto md:w-auto md:justify-start md:gap-6">
					<a href="/" class="hover:text-gray-600 dark:hover:text-gray-300">Home</a>
					<a href="/#projects" class="hover:text-gray-600 dark:hover:text-gray-300">Projects</a>
					<a href="/#contact" class="hover:text-gray-600 dark:hover:text-gray-300">Contact</a>
					<a href="/blog" class="hover:text-gray-600 dark:hover:text-gray-300">Blog</a>
					<a href="/bio" class="hover:text-gray-600 dark:hover:text-gray-300">Bio</a>
				</div>
				<div class="flex items-center gap-4 md:ml-10 md:gap-6">
					<a
						href="https://www.linkedin.com/in/tarcisio-genaro-rodrigues/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn profile"
						class="hover:text-gray-600 dark:hover:text-gray-300"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							/>
						</svg>
					</a>
					<a
						href="https://codeberg.org/tarcisio"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Codeberg profile"
						class="hover:text-gray-600 dark:hover:text-gray-300"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M11.999.747A11.974 11.974 0 0 0 0 12.75c0 2.254.635 4.465 1.833 6.376L11.837 6.19c.072-.092.251-.092.323 0l4.178 5.402h-2.992l.065.239h3.113l.882 1.138h-3.674l.103.374h3.86l.777 1.003h-4.358l.135.483h4.593l.695.894h-5.038l.165.589h5.326l.609.785h-5.717l.182.65h6.038l.562.727h-6.397l.183.65h6.717A12.003 12.003 0 0 0 24 12.75 11.977 11.977 0 0 0 11.999.747zm3.654 19.104.182.65h5.326c.173-.204.353-.433.513-.65zm.385 1.377.18.65h3.563c.233-.198.485-.428.712-.65zm.383 1.377.182.648h1.203c.356-.204.685-.412 1.042-.648z"
							/>
						</svg>
					</a>
					<a
						href="https://stackoverflow.com/users/1254880/tarc"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Stack Overflow profile"
						class="hover:text-gray-600 dark:hover:text-gray-300"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M15.725 0l-1.72 1.277 6.39 8.588 1.716-1.277L15.725 0zm-3.94 3.418l-1.369 1.644 8.225 6.85 1.369-1.644-8.225-6.85zm-3.15 4.465l-.905 1.94 9.702 4.517.904-1.94-9.701-4.517zm-1.85 4.86l-.44 2.093 10.473 2.201.44-2.092-10.473-2.203zM1.89 15.47V24h19.19v-8.53h-2.133v6.397H4.021v-6.396H1.89zm4.265 2.133v2.13h10.66v-2.13H6.154Z"
							/>
						</svg>
					</a>
					<a
						href="https://cetacea.cetaceatech.deno.net/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Cetacea"
						class="hover:opacity-75"
					>
						<img
							src="/cetacea-logo.svg"
							alt="Cetacea"
							class="h-5 w-5 brightness-0 dark:invert"
						/>
					</a>
					<button
						id="theme-toggle"
						type="button"
						aria-label="Toggle dark theme"
						class="rounded p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800"
					>
						<svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
						</svg>
						<svg class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
						</svg>
					</button>
				</div>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-gray-200 dark:border-gray-800">
			<div class="max-w-7xl mx-auto px-4 py-6 text-sm text-gray-500 dark:text-gray-400">
				&copy; {new Date().getFullYear()} Tarcísio G. Rodrigues. Built with <a
					href="https://astro.build"
					target="_blank"
					rel="noopener noreferrer"
					class="underline">Astro</a
				>.
			</div>
		</footer>

		<script is:inline>
			document.getElementById('theme-toggle').addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
		</script>
	</body>
</html>
