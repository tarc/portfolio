---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Portfolio',
	description = 'Personal portfolio site',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col">
		<header class="sticky top-0 z-10 backdrop-blur border-b border-gray-200 bg-white/80">
			<nav class="max-w-4xl mx-auto flex items-center justify-between px-4 py-3">
				<a href="/" class="font-semibold">Portfolio</a>
				<div class="flex gap-6 text-sm">
					<a href="/#about" class="hover:text-gray-600">About</a>
					<a href="/#projects" class="hover:text-gray-600">Projects</a>
					<a href="/#contact" class="hover:text-gray-600">Contact</a>
					<a href="/blog" class="hover:text-gray-600">Blog</a>
				</div>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-gray-200">
			<div class="max-w-4xl mx-auto px-4 py-6 text-sm text-gray-500">
				&copy; {new Date().getFullYear()} Portfolio. All rights reserved.
			</div>
		</footer>
	</body>
</html>
