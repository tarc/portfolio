---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog" description="Posts and writing">
	<section class="max-w-7xl mx-auto px-4 pt-28 pb-6">
		<h1 class="text-[clamp(1.75rem,9vw,7rem)] font-bold uppercase tracking-tight leading-none">Glob</h1>
		<ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				posts.map((post) => (
					<li class="h-full">
						<a
							href={`/blog/${post.id}/`}
							class="group relative flex h-full flex-col rounded-lg border border-gray-200 p-6 transition-colors hover:border-yellow-500 hover:shadow-[0_0_0_1px_rgba(234,179,8,0.3),0_0_16px_rgba(234,179,8,0.25)] dark:border-gray-800 dark:hover:border-yellow-400"
						>
							<p class="absolute top-4 right-4 text-sm text-gray-500 dark:text-gray-400">
								{formatDate(post.data.pubDate)}
							</p>
							<h2 class="pr-20 text-2xl font-medium uppercase tracking-tight underline-offset-4 transition-colors group-hover:underline group-hover:text-yellow-600 dark:group-hover:text-yellow-400">
								{post.data.title}
							</h2>
							<p class="mt-2 text-gray-600 dark:text-gray-400">{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
