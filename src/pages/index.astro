---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		name: 'Project One',
		description: 'A short description of this project and the problem it solves.',
		href: '#',
	},
	{
		name: 'Project Two',
		description: 'A short description of this project and the problem it solves.',
		href: '#',
	},
	{
		name: 'Project Three',
		description: 'A short description of this project and the problem it solves.',
		href: '#',
	},
];
---

<Layout title="Portfolio" description="Personal portfolio site">
	<section id="hero" class="max-w-4xl mx-auto px-4 py-24 text-center">
		<h1 class="text-4xl font-bold">Hi, I'm Your Name</h1>
		<p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
			I build things for the web. Here's a look at who I am and what I've made.
		</p>
	</section>

	<section id="about" class="max-w-4xl mx-auto px-4 py-16">
		<h2 class="text-2xl font-semibold">About</h2>
		<p class="mt-4 text-gray-600 dark:text-gray-400">
			Write a short bio here — your background, what you work on, and what you're
			interested in.
		</p>
	</section>

	<section id="projects" class="max-w-4xl mx-auto px-4 py-16">
		<h2 class="text-2xl font-semibold">Projects</h2>
		<div class="mt-6 grid gap-6 sm:grid-cols-2">
			{
				projects.map((project) => (
					<a
						href={project.href}
						class="block rounded-lg border border-gray-200 p-6 hover:border-gray-400 transition-colors dark:border-gray-800 dark:hover:border-gray-600"
					>
						<h3 class="font-medium">{project.name}</h3>
						<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{project.description}</p>
					</a>
				))
			}
		</div>
	</section>

	<section id="contact" class="max-w-4xl mx-auto px-4 py-16">
		<h2 class="text-2xl font-semibold">Contact</h2>
		<p class="mt-4 text-gray-600 dark:text-gray-400">
			Get in touch at <a href="mailto:you@example.com" class="underline">you@example.com</a>.
		</p>
	</section>
</Layout>
