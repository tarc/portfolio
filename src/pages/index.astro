---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = await getCollection('projects');
---

<Layout title="Portfolio" description="Personal portfolio site">
	<section id="hero" class="max-w-4xl mx-auto px-4 py-8 text-left">
		<h1 class="mt-8 mb-3 whitespace-nowrap text-[clamp(1.5rem,7vw,4.5rem)] font-bold leading-none">
			BACKEND ENGINEER
		</h1>
		<p class="mb-4 max-w-xl text-[1.2rem] text-gray-600 dark:text-gray-400">
			Backend software developer with strong expertise in low-latency, high-performance
			critical systems.
		</p>
		<a
			href="#projects"
			class="inline-block rounded-md border border-gray-900 px-6 py-3 font-semibold uppercase tracking-wide transition-colors hover:bg-gray-900 hover:text-white dark:border-gray-100 dark:hover:bg-gray-100 dark:hover:text-gray-900"
		>
			Explore Projects →
		</a>
	</section>

	<section id="about" class="max-w-4xl mx-auto px-4 pt-28 pb-6">
		<div class="grid gap-6 sm:grid-cols-[1fr_240px] sm:items-start">
			<div>
				<h2 class="mb-3 text-3xl font-bold uppercase tracking-tight md:text-4xl">About Me</h2>
				<p class="mt-2 text-gray-600 dark:text-gray-400">
					I build backend systems that run where milliseconds matter — market data feeds,
					payment rails, and risk engines where a slow path is a broken path. As a Backend
					Engineer specializing in low-latency, high-performance systems, I don't settle for code
					that merely works.
				</p>
				<p class="mt-2 text-gray-600 dark:text-gray-400">
					Whether it's a C++ feed handler parsing FIX/SBE at wire speed or a distributed
					pipeline extracting analytics from billions of events, I build for correctness under
					load and hold the line when things get busy. I'm passionate about distributed systems,
					observability, and squeezing performance out of every layer of the stack.
				</p>
			</div>
			<div class="mx-auto aspect-square w-full max-w-[240px] rounded-lg border border-gray-300 flex items-center justify-center dark:border-gray-700">
				<svg
					class="h-16 w-16 text-gray-400 dark:text-gray-600"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="1.5"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
					/>
				</svg>
			</div>
		</div>
	</section>

	<section id="projects" class="max-w-4xl mx-auto px-4 pt-28 pb-6">
		<h2 class="mb-3 text-3xl font-bold uppercase tracking-tight md:text-4xl">Featured Projects</h2>
		<p class="mb-4 max-w-2xl text-[1.1rem] text-gray-600 dark:text-gray-400">
			A selection of side projects and open-source work.
		</p>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((project) => (
					<a
						href={project.data.link}
						target="_blank"
						rel="noopener noreferrer"
						class="block rounded-lg border border-gray-200 p-6 hover:border-gray-400 transition-colors dark:border-gray-800 dark:hover:border-gray-600"
					>
						<h3 class="font-medium">{project.data.title}</h3>
						<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{project.data.description}</p>
						<div class="mt-3 flex flex-wrap gap-2">
							{project.data.tags.map((tag) => (
								<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-400">
									{tag}
								</span>
							))}
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section id="contact" class="max-w-4xl mx-auto px-4 pt-28 pb-6 text-center">
		<h2 class="mb-4 text-3xl font-bold uppercase tracking-tight md:text-4xl">Get in Touch</h2>
		<form class="mx-auto max-w-lg space-y-4 text-left">
			<div>
				<label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">Email</label>
				<input
					type="email"
					name="email"
					placeholder="your@email.com"
					required
					class="w-full rounded-md border border-gray-300 bg-transparent px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-400 dark:border-gray-700"
				/>
			</div>
			<div>
				<label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">Message</label>
				<textarea
					name="message"
					rows="6"
					placeholder="Tell me about your project..."
					required
					class="w-full rounded-md border border-gray-300 bg-transparent px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-400 dark:border-gray-700"
				></textarea>
			</div>
			<button
				type="submit"
				class="w-full rounded-md border border-gray-900 px-6 py-3 font-semibold uppercase tracking-wide transition-colors hover:bg-gray-900 hover:text-white dark:border-gray-100 dark:hover:bg-gray-100 dark:hover:text-gray-900"
			>
				Send Message →
			</button>
		</form>
	</section>
</Layout>
