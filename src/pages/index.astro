---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/homeoffice.jpeg';

const projects = await getCollection('projects');
---

<Layout title="Portfolio" description="Personal portfolio site">
	<section id="hero" class="max-w-7xl mx-auto px-4 py-8 text-left">
		<h1 class="mt-8 mb-3 whitespace-nowrap text-[clamp(1.75rem,9vw,7rem)] font-bold leading-none">
			BACKEND ENGINEER
		</h1>
		<p class="mb-4 max-w-xl text-[1.2rem] text-gray-600 dark:text-gray-400">
			Backend software developer with strong expertise in low-latency, high-performance
			critical systems.
		</p>
		<a
			href="#projects"
			class="inline-block rounded-md border border-cyan-600 px-6 py-3 font-semibold uppercase tracking-wide transition-colors hover:bg-cyan-600 hover:text-white dark:border-cyan-400 dark:hover:bg-cyan-400 dark:hover:text-gray-900"
		>
			Explore Projects →
		</a>
	</section>

	<section id="about" class="max-w-7xl mx-auto px-4 pt-28 pb-6">
		<div class="grid gap-6 sm:grid-cols-[1fr_320px] sm:items-start">
			<div>
				<h2 class="mb-3 text-6xl font-bold uppercase tracking-tight md:text-7xl">About Me</h2>
				<p class="mt-2 text-gray-600 dark:text-gray-400">
					I build backend systems that run where milliseconds matter, be it market data feeds,
					payment rails, risk engines, or order management systems. As a Backend
					Engineer specializing in low-latency, high-performance systems, I don't settle for code
					that merely works.
				</p>
				<p class="mt-2 text-gray-600 dark:text-gray-400">
					Whether it's a C++ feed handler parsing FIX/SBE at wire speed or a distributed
					pipeline extracting analytics from billions of events, I build for correctness under
					load. I'm passionate about distributed systems, observability, and performance
					profiling.
				</p>
				<p class="mt-2 text-gray-600 dark:text-gray-400">
					I'm available for contract work. If you'd like to talk, reach out through the <a
						href="#contact"
						class="underline">contact form below</a
					> or check my <a href="/bio" class="underline">Bio</a> page, where you can find my CV.
				</p>
				<a
					href="/blog"
					class="mt-6 inline-block rounded-md border border-cyan-600 px-6 py-3 font-semibold uppercase tracking-wide transition-colors hover:bg-cyan-600 hover:text-white dark:border-cyan-400 dark:hover:bg-cyan-400 dark:hover:text-gray-900"
				>
					Read the Blog →
				</a>
			</div>
			<div class="mx-auto aspect-square w-full max-w-[320px] overflow-hidden rounded-lg border border-gray-300 dark:border-gray-700">
				<Image
					src={portrait}
					alt="Portrait of Tarcísio G. Rodrigues"
					width={320}
					height={320}
					class="h-full w-full object-cover grayscale"
				/>
			</div>
		</div>
	</section>

	<section id="projects" class="max-w-7xl mx-auto px-4 pt-28 pb-6">
		<h2 class="mb-3 text-6xl font-bold uppercase tracking-tight md:text-7xl">Featured Projects</h2>
		<p class="mb-4 max-w-2xl text-[1.1rem] text-gray-600 dark:text-gray-400">
			A selection of side projects and open-source work.
		</p>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((project) => (
					<a
						href={project.data.link}
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-lg border border-gray-200 p-6 transition-colors hover:border-cyan-500 hover:shadow-[0_0_0_1px_rgba(6,182,212,0.3),0_0_16px_rgba(6,182,212,0.25)] dark:border-gray-800 dark:hover:border-cyan-400"
					>
						<h3 class="text-2xl font-medium transition-colors group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
							{project.data.title}
						</h3>
						<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{project.data.description}</p>
						<div class="mt-3 flex flex-wrap gap-2">
							{project.data.tags.map((tag) => (
								<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-400">
									{tag}
								</span>
							))}
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section id="contact" class="max-w-7xl mx-auto px-4 pt-28 pb-6 text-center">
		<h2 class="mb-4 text-6xl font-bold uppercase tracking-tight md:text-7xl">Get in Touch</h2>
		<form id="contact-form" class="mx-auto max-w-lg space-y-4 text-left">
			<div>
				<label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">Email</label>
				<input
					type="email"
					name="email"
					placeholder="your@email.com"
					required
					class="w-full rounded-md border border-gray-300 bg-transparent px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-400 dark:border-gray-700"
				/>
			</div>
			<div>
				<label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">Message</label>
				<textarea
					name="message"
					rows="6"
					placeholder="Tell me about your project..."
					required
					class="w-full rounded-md border border-gray-300 bg-transparent px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-400 dark:border-gray-700"
				></textarea>
			</div>
			<div class="hidden" aria-hidden="true">
				<label for="website">Website</label>
				<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
			</div>
			<button
				type="submit"
				class="w-full rounded-md border border-cyan-600 px-6 py-3 font-semibold uppercase tracking-wide transition-colors hover:bg-cyan-600 hover:text-white dark:border-cyan-400 dark:hover:bg-cyan-400 dark:hover:text-gray-900"
			>
				Send Message →
			</button>
			<p id="contact-status" class="text-sm" role="status"></p>
		</form>

		<div
			id="contact-success"
			class="mx-auto hidden max-w-lg rounded-lg bg-gray-100 p-6 text-left text-cyan-600 dark:bg-gray-800 dark:text-cyan-400"
			role="status"
		>
			Thanks — I've received your message and will get back to you soon.
		</div>

		<script>
			// Replace with your Deno Deploy project URL once deployed.
			// See server/contact/main.ts for the function this calls.
			const CONTACT_ENDPOINT = 'https://portfolio-contact.tarcisio.deno.net/';

			const form = document.getElementById('contact-form') as HTMLFormElement;
			const status = document.getElementById('contact-status') as HTMLParagraphElement;
			const success = document.getElementById('contact-success') as HTMLDivElement;

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
				const data = Object.fromEntries(new FormData(form));

				submitButton.disabled = true;
				status.textContent = 'Sending...';
				status.className = 'text-sm text-gray-500 dark:text-gray-400';

				try {
					const response = await fetch(CONTACT_ENDPOINT, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(data),
					});
					const result = await response.json();

					if (!response.ok) {
						throw new Error(result.error ?? 'Something went wrong');
					}

					form.reset();
					form.classList.add('hidden');
					success.classList.remove('hidden');
				} catch (err) {
					status.textContent = err instanceof Error ? err.message : 'Something went wrong';
					status.className = 'text-sm text-red-600 dark:text-red-400';
				} finally {
					submitButton.disabled = false;
				}
			});
		</script>
	</section>
</Layout>
